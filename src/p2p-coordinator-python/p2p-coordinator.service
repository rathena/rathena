[Unit]
Description=P2P Coordinator — WebRTC signaling and auth for WARP-p2p-client
Documentation=https://github.com/iskandarsulaili/rathena-AI-world
After=network.target dragonfly.service
Wants=network.target dragonfly.service

[Service]
Type=simple
ExecStart=python3 -m p2p_coordinator.main
Restart=always
RestartSec=5
WorkingDirectory=%h/rathena-AI-world/src/p2p-coordinator-python
Environment=P2P_COORDINATOR_HOST=0.0.0.0
Environment=P2P_COORDINATOR_PORT=8001
Environment=P2P_REDIS_URL=redis://localhost:6379/0
Environment=P2P_LOG_LEVEL=INFO

[Install]
WantedBy=multi-user.target
